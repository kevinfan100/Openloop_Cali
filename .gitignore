# Claude Code
.claude/

# Large raw binary data files
*.dat

# MATLAB temporary / auto-save files
*.asv
*.m~

# Per-frequency diagnostic plots (regenerated by scripts)
**/diagnostics/Overlay_*.png
**/diagnostics/Spectrum_*.png
**/diagnostics/0p1Hz_Analysis.png
**/diagnostics/Dashboard_Summary.png

# Intermediate .mat files (use CSV for version control)
**/bode_data/*.mat
**/fitting_results/*.mat

# Generated figures (regenerated by pipeline)
**/figures/*.png

# Comparison plots (regenerated by step_compare)
results/Comparison_Bode.png
Comparison_Hung_NTU_Scaled_*.png

# Temporary scripts and outputs (clean before commit)
test_*.m
temp_*.m
